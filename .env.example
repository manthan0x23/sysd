# Auth.js. Sign-in is GitHub and Google only.
# Generate a secret with:  openssl rand -base64 33
AUTH_SECRET=

# GitHub: https://github.com/settings/developers -> New OAuth App
#   Homepage URL:      http://localhost:3123
#   Callback URL:      http://localhost:3123/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google: https://console.cloud.google.com/apis/credentials -> Create credentials -> OAuth client ID (Web application)
#   Authorized JavaScript origin:   http://localhost:3123
#   Authorized redirect URI:        http://localhost:3123/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Postgres. Locally this is the docker-compose database (password also goes in POSTGRES_PASSWORD).
# In production use your Neon pooled connection string.
POSTGRES_PASSWORD=
# format: postgres://USER:PASSWORD@HOST:PORT/DBNAME   (locally: user sysd, host localhost, port 5432, db sysd)
DATABASE_URL=

