{
  "name": "sysd",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose --env-file .env.local up -d --wait db",
    "db:down": "docker compose --env-file .env.local down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:psql": "docker exec -it sysd-db psql -U sysd -d sysd",
    "test:db": "tsx scripts/test-db.mts",
    "test:billing": "tsx scripts/test-billing.mts",
    "test:layout": "tsx scripts/test-layout.mts",
    "test:route": "tsx scripts/test-route.mts",
    "test:trace": "tsx scripts/test-trace.mts",
    "test:smart": "tsx scripts/test-smart.mts",
    "test:uploads": "tsx scripts/test-uploads.mts",
    "plan": "node scripts/set-plan.mjs",
    "prices:api": "node --max-old-space-size=8000 scripts/prices/run.mjs",
    "prices:fetch": "node scripts/prices/fetch.mjs",
    "prices:validate": "tsx scripts/prices/validate.mjs",
    "prices:status": "node scripts/prices/status.mjs",
    "prices:coverage": "tsx scripts/prices/coverage.mjs --list",
    "prices:xlsx": "tsx scripts/prices/xlsx.mjs",
    "prices:import": "tsx scripts/prices/import.mts",
    "prices:approve": "tsx scripts/prices/approve.mts",
    "prices:snapshot": "tsx scripts/prices/snapshot.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@aws-sdk/s3-request-presigner": "^3.1148.0",
    "@dodopayments/nextjs": "^0.3.9",
    "@vercel/analytics": "^2.0.1",
    "@xyflow/react": "^12.12.0",
    "dodopayments": "^2.54.0",
    "drizzle-orm": "^0.45.4",
    "elkjs": "^0.12.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.53.0",
    "next": "16.4.0",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@iconify-json/logos": "^1.2.15",
    "@iconify-json/simple-icons": "^1.2.99",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
